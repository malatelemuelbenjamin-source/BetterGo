# BetterGo Marinduque - environment configuration (copy to .env)
# Never commit real secrets.

NODE_ENV=development

# API server
API_PORT=3001
APP_ORIGIN=http://localhost:3000

# Session signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# SQLite database file (free, file-based alternative to a hosted database)
DATABASE_PATH=./data/bettergo.db

# Public site URL used for canonical links and SEO
PUBLIC_SITE_URL=http://localhost:3000

# Optional transactional email (leave empty to disable real delivery)
SMTP_URL=
MAIL_FROM="BetterGo Marinduque <no-reply@example.com>"

# Set to "true" to expose email verification links in the API response for local testing only
DEV_EXPOSE_VERIFICATION_LINKS=false
